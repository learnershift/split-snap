{
  "name": "split-snap",
  "version": "1.0.0",
  "type": "module",
  "description": "A mobile-first, local-only PWA for splitting a single bill exactly among 2–8 people, including tax, tip, unequal shares, deterministic rounding, and a plain-text result.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "vite build",
    "seal:dist": "node scripts/seal-dist.mjs",
    "preview": "node scripts/preview-dist.mjs",
    "test:e2e": "playwright test",
    "test:offline": "playwright test --grep @offline",
    "test:install": "playwright test --grep @install",
    "test:a11y": "playwright test --grep @a11y",
    "test:privacy": "playwright test --grep @privacy",
    "check:source": "npm run typecheck && npm run lint && npm run test:unit -- --run && npm run test:coverage",
    "verify:dist": "node scripts/verify-dist.mjs",
    "check": "npm run check:source && npm run build",
    "verify": "npm run check && npm run seal:dist -- --dir dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/learnershift/split-snap.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/learnershift/split-snap/issues"
  },
  "homepage": "https://github.com/learnershift/split-snap#readme",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
